# Base URL for the NestJS backend (Server/), including the global "api/v1"
# prefix. Use your machine's LAN IP (not "localhost") so physical devices and
# simulators/emulators on the same network can reach it — "localhost" on a
# device/emulator refers to the device itself, not your dev machine.
#
# Expo exposes any env var prefixed with EXPO_PUBLIC_ to client code at build
# time (built into the SDK since 49, no extra config needed here).
EXPO_PUBLIC_API_URL=http://10.10.11.159:5000/api/v1
